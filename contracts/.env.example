# Private key wallet deployer (yang ada ETH di Base untuk gas)
# JANGAN commit file ini ke git!
PRIVATE_KEY=

# Basescan API key untuk auto-verify contract (daftar gratis di basescan.org/apis)
# Kosongkan kalau belum punya — contract tetap ter-deploy, cuma tidak auto-verify
BASESCAN_API_KEY=

# ═══════════════════════════════════════════
# Deploy configuration (REQUIRED)
# ═══════════════════════════════════════════

# Treasury address — penerima platform fee (5%)
# Gunakan Safe multisig, JANGAN pakai EOA/wallet biasa
TREASURY_ADDRESS=

# Owner address — yang bisa pause/unpause dan ganti treasury
# Gunakan Safe multisig sebagai owner
OWNER_ADDRESS=

# ═══════════════════════════════════════════
# Deploy configuration (OPTIONAL — ada default)
# ═══════════════════════════════════════════

# Token address (default: Base Mainnet)
# USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# USDT_ADDRESS=0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2

# RPC URL & Chain ID (default: Base Mainnet)
# RPC_URL=https://mainnet.base.org
# CHAIN_ID=8453

# Untuk testnet (Base Sepolia):
# RPC_URL=https://sepolia.base.org
# CHAIN_ID=84532
# USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# USDT_ADDRESS=0x7169D38e021C927c3156cFa2db967b06cDFC8b03

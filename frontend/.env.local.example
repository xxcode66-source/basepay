# Dapatkan gratis di https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# USDC TipRouter hasil deploy (existing)
NEXT_PUBLIC_TIP_ROUTER_ADDRESS=

# USDC di Base — mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# testnet (Base Sepolia): 0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_USDC_ADDRESS=

# USDT di Base — mainnet: 0xfde4C96c8593536E31F229EA8f37b2ADa2699bb2
# testnet (Base Sepolia): 0x7169D38e021C927c3156cFa2db967b06cDFC8b03
NEXT_PUBLIC_USDT_ADDRESS=

# TipRouterUSDT address (set after deploying TipRouterUSDT.sol)
NEXT_PUBLIC_TIP_ROUTER_USDT_ADDRESS=

# Base URL untuk generate QR code, contoh: https://basepay.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base RPC URL (optional — default: https://mainnet.base.org)
# Gunakan Alchemy/Infora untuk production
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# ═══════════════════════════════════════════
# Robinhood Chain (Chain ID: 4663)
# ═══════════════════════════════════════════

# TipRouter contract on Robinhood Chain (deploy with deploy-robinhood.ps1)
NEXT_PUBLIC_RH_TIP_ROUTER_ADDRESS=

# TipRouterUSDT on Robinhood Chain (optional)
NEXT_PUBLIC_RH_TIP_ROUTER_USDT_ADDRESS=

# USDG on Robinhood Chain (default: 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168)
NEXT_PUBLIC_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Robinhood Chain RPC URL (optional — default: https://rpc.mainnet.chain.robinhood.com)
NEXT_PUBLIC_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

